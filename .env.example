# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị nếu cần.
# Chạy trên máy thì KHÔNG cần điền gì cả.

# ===== Frontend (Vite) =====
# Địa chỉ backend khi deploy tách riêng, vd: https://fintech-vault-api.onrender.com
VITE_API_URL=

# ===== Backend =====
PORT=4000

# Turso (database online). Để trống → dùng file SQLite tại server/data/fintech-vault.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Đường dẫn file SQLite khi không dùng Turso (mặc định: server/data/fintech-vault.db)
DB_PATH=

# Domain frontend được phép gọi API, cách nhau bởi dấu phẩy. "*" = cho phép tất cả.
CORS_ORIGIN=*

# Tự tạo tài khoản demo admin@gmail.com / 123456 kèm dữ liệu mẫu (đặt false để tắt)
SEED_DEMO=true
